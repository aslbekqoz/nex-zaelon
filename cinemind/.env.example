# PostgreSQL ulanish manzili (docker compose up -d bilan mos keladi)
DATABASE_URL=postgres://cinemind:cinemind@localhost:5432/cinemind

# Ixtiyoriy: TMDB kaliti (v3 API key yoki v4 "Read Access Token").
# Berilsa, qidiruv TMDB'dan haqiqiy filmlarni topib bazaga qo'shadi,
# batafsil sahifalar poster, reyting va treyler bilan to'ldiriladi.
TMDB_API_KEY=
# TMDB ma'lumotlari qaysi tilda olinadi (uz-UZ to'liq bo'lmasa, ru-RU yoki en-US)
TMDB_LANGUAGE=en-US
