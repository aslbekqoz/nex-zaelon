# PostgreSQL connection string (matches `docker compose up -d`)
DATABASE_URL=postgres://cinemind:cinemind@localhost:5432/cinemind

# Optional: TMDB key (v3 API key or v4 "Read Access Token").
# When set, search imports real movies from TMDB into the catalogue and
# detail pages are enriched with posters, ratings and trailers.
TMDB_API_KEY=
# Language for TMDB data (e.g. en-US, ru-RU, uz-UZ)
TMDB_LANGUAGE=en-US
# Country for "Where to watch" (two letters, e.g. UZ, KZ, US). Defaults to UZ.
TMDB_REGION=UZ

# Optional: enables "Write synopsis with AI" in the Content Studio (Claude API key).
# Facts are never AI-generated, and nothing is ever published automatically.
ANTHROPIC_API_KEY=

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For (nginx, Vercel,
# Cloudflare…). Enables per-IP sign-in/sign-up limits. Without a proxy these headers can be
# forged, so leave it unset: per-email sign-in limits still apply.
TRUST_PROXY_HEADERS=

# Email confirmation: "required" (default) blocks account features until the address is
# confirmed; "optional" only shows a reminder banner.
EMAIL_VERIFICATION=required

# Public address of the site, used in links inside emails (password reset).
# Required in production; defaults to http://localhost:3000 in development.
APP_URL=

# Outgoing email over SMTP, e.g. smtps://user:password@smtp.example.com:465
# Without it, development prints emails to the server console; production sends nothing.
SMTP_URL=
MAIL_FROM="CineMind AI <no-reply@example.com>"
