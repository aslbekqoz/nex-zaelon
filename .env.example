# ============================================================
#  Bu faylni nusxalab, nomini .env qiling va qiymatlarni to'ldiring:
#     cp .env.example .env
#  .env ichidagi kalitlarni HECH KIMGA bermang va GitHub'ga joylamang!
# ============================================================

# --- 1) Google Gemini (matn: tadqiqot, ssenariy, sarlavha) ---
# Olish: https://aistudio.google.com/apikey  (bepul)
GEMINI_API_KEY=
# Model. Bepul limitga sig'masa yoki xato bersa, ro'yxatdagi keyingisi sinab ko'riladi.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash

# --- 2) Cloudflare Workers AI (rasmlar, kuniga 10 000 "neuron" bepul) ---
# Account ID: dash.cloudflare.com -> o'ng tomonda "Account ID"
# Token: My Profile -> API Tokens -> Create Token -> "Workers AI" shabloni
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- 3) Ovoz (Microsoft Edge ovozlari, bepul, kalit kerak emas) ---
TTS_VOICE=en-US-AndrewNeural

# --- 4) Telegram bot (ruxsat so'rash) ---
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# Botga /start yozing, keyin:  npm run telegram-id
TELEGRAM_CHAT_ID=
# Necha daqiqa javob kutilsin
APPROVAL_TIMEOUT_MIN=15
# Javob kelmasa nima qilinsin: approve (yuklash) yoki reject (yuklamaslik)
APPROVAL_DEFAULT=approve

# --- 5) YouTube (OAuth) ---
# Google Cloud Console -> YouTube Data API v3 -> OAuth client (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Bu qatorni "npm run auth" o'zi to'ldirib beradi
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
# Eslatma: API audit'dan o'tmagan loyihada YouTube baribir "private" qiladi.
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=27

# --- Rejalashtirish ---
# Har kungi e'lon vaqtlari (Toshkent). Videolar oldindan tayyorlanib, YouTube'da shu vaqtlarga rejalashtiriladi.
# Bo'sh qoldirilsa — har video yuklangan zahoti e'lon qilinadi.
PUBLISH_SLOTS=02:00,09:30,22:00
# Necha kun oldinga tayyorlab qo'yish
BUFFER_DAYS=7
# Bir kunda ko'pi bilan nechta video yasash (Cloudflare bepul limiti ~5-6 video/kun)
MAX_PER_DAY=5

# --- Uzun videolar (16:9, "Top 10", ~7 daqiqa) ---
# E'lon kunlari va vaqti: sat-18:00 yoki wed-18:00,sat-18:00. Bo'sh = uzun video yo'q
LONG_SLOTS=sat-18:00
# Uzunligi (so'z). ~950 so'z = ~7 daqiqa
LONG_WORDS=950
# E'londan necha kun oldin tayyorlansin (Cloudflare limiti bir kunda yetmasa, keyingi kuni davom etadi)
LONG_LEAD_DAYS=3

# --- Umumiy ---
# Ssenariy uzunligi (so'zlar soni). ~105 so'z = ~40 soniya (qisqa video oxirigacha ko'proq ko'riladi)
SCRIPT_WORDS=105
# Sahnalar soni (bo'sh qolsa: har ~12 so'zga bitta)
SCENES=
# Rasm modeli: flux-2-klein-4b (vertikal, qahramon bir xil) yoki flux-1-schnell (zaxira)
IMAGE_MODEL=flux-2-klein-4b
# 1 = qahramon uchun namuna-rasm ishlatish (aniqroq, lekin filtrga tushishi mumkin). Bo'sh = matn + seed
CHARACTER_REF=

# --- Nex Zaelon (musiqa kanali) ---
# "npm run nex:auth" o'zi to'ldiradi (boshqa Google akkaunt)
NEX_YOUTUBE_REFRESH_TOKEN=
# E'lon vaqtlari (Toshkent)
NEX_SLOTS=11:30,17:30,23:30
